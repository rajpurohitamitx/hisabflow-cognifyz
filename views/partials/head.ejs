<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const pageTitle = (title ? title + ' · ' : '') + 'HisaabFlow';
     const desc = 'Type "Ramesh ne 2 kg chini liya, 50 diye" and HisaabFlow writes the udhaar entry. See who to ask for money today. Works in English, Hindi and Tamil.';
     const base = (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl : ''; %>
  <meta name="description" content="<%= desc %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="HisaabFlow">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:image" content="<%= base %>/img/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="HisaabFlow – Aaj kis se paisa lena hai?">
  <% if (base) { %><meta property="og:url" content="<%= base %><%= typeof currentPath !== 'undefined' ? currentPath : '/' %>"><link rel="canonical" href="<%= base %><%= typeof currentPath !== 'undefined' ? currentPath : '/' %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= desc %>">
  <meta name="twitter:image" content="<%= base %>/img/og-image.png">
  <title><%= title ? title + ' · ' : '' %>HisaabFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/img/icon-180.png">
  <meta name="theme-color" content="#145a3f">
  <link href="/css/app.css?v=20261011g" rel="stylesheet">
</head>
<body>
