<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <div class="mb-4"><h1 class="page-title">Add an entry</h1><p class="muted mb-0">Fill the form, or just type it like you would tell someone.</p></div>

  <div class="entry-switch" aria-label="Entry mode">
    <a href="#structured" data-entry-route="structured" class="entry-tab">Form</a>
    <a href="#natural" data-entry-route="natural" class="entry-tab">Type it</a>
  </div>

  <div class="row g-4">
    <div class="col-lg-7 entry-panel" data-entry-panel="structured">
      <div class="panel-card h-100">
        <div class="panel-head"><div><h2>Fill the form</h2><p>Pick the customer, then the amount.</p></div></div>
        <form id="transactionForm" novalidate>
          <div class="row g-3">
            <div class="col-12"><label class="form-label" for="customerId">Customer</label><select id="customerId" name="customerId" class="form-select form-select-lg" required><option value="">Choose customer</option><option value="__new__">+ Add new customer…</option><% customers.forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %></select><div class="form-text">The transaction stays attached to this customer's ledger.</div>
              <div id="newCustomerFields" class="new-customer-fields d-none">
                <div class="row g-2">
                  <div class="col-sm-7"><label class="form-label" for="inlineCustomerName">New customer name</label><input id="inlineCustomerName" class="form-control" maxlength="80" autocomplete="off" placeholder="e.g. Ramesh"></div>
                  <div class="col-sm-5"><label class="form-label" for="inlineCustomerPhone">Phone <span class="muted fw-normal">(optional)</span></label><input id="inlineCustomerPhone" class="form-control" maxlength="20" inputmode="tel"></div>
                </div>
              </div>
            </div>
            <div class="col-md-6"><label class="form-label" for="txType">Type</label><select id="txType" name="type" class="form-select form-select-lg"><option value="credit">Credit given</option><option value="payment">Payment received</option></select></div>
            <div class="col-md-6"><label class="form-label" for="txAmount">Amount</label><div class="input-group input-group-lg"><span class="input-group-text">₹</span><input id="txAmount" name="amount" type="number" min="1" step="0.01" class="form-control" required></div></div>
            <div class="col-12"><label class="form-label" for="txDescription">Description <span class="muted fw-normal">(optional)</span></label><input id="txDescription" name="description" class="form-control" maxlength="200" placeholder="3 notebooks, monthly grocery bill…"></div>
          </div>
          <button class="btn btn-primary btn-lg rounded-pill mt-4 px-4">Save transaction</button>
          <div id="txMessage" class="mt-3" aria-live="polite"></div>
        </form>
      </div>
    </div>

    <div class="col-lg-5 entry-panel" data-entry-panel="natural">
      <div class="panel-card natural-card h-100" id="natural">
        <h2>Just type it</h2>
        <p class="muted">English, Hindi, Tamil or a mix – whatever comes naturally. Add items, quantity and price if you want. You see a preview before anything is saved.</p>
        <textarea id="naturalText" class="form-control natural-input" rows="4" maxlength="400" placeholder="e.g. Ramesh took 2 kg sugar at 45 and 1 litre oil for 180, paid 100"></textarea>
        <button id="parseNatural" class="btn btn-dark btn-lg w-100 rounded-pill mt-3">Review entry</button>
        <div id="naturalResult" class="mt-3" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <div class="row g-4 mt-1">
    <div class="col-lg-5 ms-auto"><div class="panel-card"><h2>New customer</h2><p class="muted">Add them once, then pick them from the list.</p><form id="customerForm"><label class="form-label" for="newCustomerName">Name</label><input id="newCustomerName" name="name" class="form-control" required maxlength="80"><label class="form-label mt-3" for="newCustomerPhone">Phone <span class="muted fw-normal">(optional)</span></label><input id="newCustomerPhone" name="phone" class="form-control" maxlength="20"><button class="btn btn-soft w-100 rounded-pill mt-3">Add customer</button><div id="customerMessage" class="mt-3" aria-live="polite"></div></form></div></div>
  </div>
</main><%- include('../partials/footer') %>
