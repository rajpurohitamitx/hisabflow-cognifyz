<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <div class="page-head"><div><h1 class="page-title">Add an entry</h1><p class="page-lead">Type it like you’d say it, or fill in the form. Nothing is saved until you confirm.</p></div></div>

  <nav class="tabs" aria-label="Entry mode">
    <a href="#natural" data-entry-route="natural" class="tab">Type it</a>
    <a href="#structured" data-entry-route="structured" class="tab">Fill the form</a>
  </nav>

  <div class="row g-4">
    <div class="col-lg-7 entry-panel" data-entry-panel="natural">
      <div class="sheet">
        <h2 class="sheet-title">Say what happened</h2>
        <p class="sheet-sub">Customer, items, quantity, rate and payment — in any order.</p>
        <label class="visually-hidden" for="naturalText">Describe the entry</label>
        <textarea id="naturalText" class="form-control natural-input" rows="4" maxlength="300" placeholder="Meena took 2 kg sugar at 45 and a litre of oil for 130, paid 100"></textarea>
        <ul class="examples" aria-label="Examples to try">
          <li><button type="button" class="example-chip">Meena took rice 5 kg 300</button></li>
          <li><button type="button" class="example-chip">3 notebooks at 40 each for Ravi</button></li>
          <li><button type="button" class="example-chip">received 500 from Anita</button></li>
          <li><button type="button" class="example-chip">Kumar udhaar 250, paid 100</button></li>
          <li><button type="button" class="example-chip">Priya cleared her dues</button></li>
        </ul>
        <button id="parseNatural" class="btn btn-primary btn-lg mt-3">Review entry</button>
        <div id="naturalResult" class="mt-3" aria-live="polite"></div>
      </div>
    </div>

    <div class="col-lg-7 entry-panel" data-entry-panel="structured">
      <div class="sheet">
        <h2 class="sheet-title">Entry form</h2>
        <p class="sheet-sub">Pick the customer, the type and the amount.</p>
        <form id="transactionForm" novalidate>
          <div class="row g-3">
            <div class="col-12"><label class="form-label" for="customerId">Customer</label>
              <select id="customerId" name="customerId" class="form-select" required><option value="">Choose a customer</option><% customers.forEach(c => { %><option value="<%= c._id %>"><%= c.name %></option><% }) %></select></div>
            <div class="col-md-6"><label class="form-label" for="txType">Type</label><select id="txType" name="type" class="form-select"><option value="credit">Credit given</option><option value="payment">Payment received</option></select></div>
            <div class="col-md-6"><label class="form-label" for="txAmount">Amount (₹)</label><input id="txAmount" name="amount" type="number" min="0.01" step="0.01" inputmode="decimal" class="form-control" required></div>
            <div class="col-12"><label class="form-label" for="txDescription">Details <span class="muted fw-normal">(optional)</span></label><input id="txDescription" name="description" class="form-control" maxlength="200" placeholder="2 kg sugar, 1 L oil"></div>
          </div>
          <button class="btn btn-primary btn-lg mt-4">Save entry</button>
          <div id="txMessage" class="mt-3" aria-live="polite"></div>
        </form>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="sheet">
        <h2 class="sheet-title">New customer</h2>
        <p class="sheet-sub">Typing a new name above adds them automatically. Use this to add a phone number for reminders.</p>
        <form id="customerForm" novalidate>
          <label class="form-label" for="newCustomerName">Name</label><input id="newCustomerName" name="name" class="form-control" required maxlength="80" autocomplete="off">
          <label class="form-label mt-3" for="newCustomerPhone">Phone <span class="muted fw-normal">(optional)</span></label><input id="newCustomerPhone" name="phone" class="form-control" maxlength="20" inputmode="tel" autocomplete="off">
          <button class="btn btn-quiet w-100 mt-3">Add customer</button>
          <div id="customerMessage" class="mt-3" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
