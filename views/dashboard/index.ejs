<%- include('../partials/head') %><%- include('../partials/nav') %>
<%
  const hr = Number(new Date().toLocaleString('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Kolkata' }));
  const hello = hr < 12 ? 'Good morning' : hr < 17 ? 'Good afternoon' : 'Good evening';
  const first = shop.ownerName.trim().split(' ')[0];
  const firstName = first.charAt(0).toUpperCase() + first.slice(1);
  const attention = followUps.filter(x => x.level !== 'healthy').length;
  const label = { urgent: 'Follow up now', watch: 'Keep an eye', healthy: 'Low' };
%>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <div class="page-head">
    <div><h1 class="page-title"><%= hello %>, <%= firstName %>.</h1><p class="page-lead"><%= attention ? attention + (attention === 1 ? ' customer needs' : ' customers need') + ' a follow-up today.' : 'Nobody needs a follow-up right now.' %></p></div>
    <div class="d-flex gap-2"><a href="/entry" class="btn btn-primary">Add entry</a><a href="/daily-closing" class="btn btn-quiet">Daily closing</a></div>
  </div>

  <section class="summary mb-4" aria-label="Summary">
    <div><div class="summary-label">Total outstanding</div><div class="big-figure"><%= inr(stats.outstanding) %></div><p class="summary-note">Credit given that has not been paid back yet.</p></div>
    <dl class="figures">
      <div><dt>Credit given</dt><dd><%= inr(stats.credit) %></dd></div>
      <div><dt>Payments received</dt><dd><%= inr(stats.payments) %></dd></div>
      <div><dt>Customers</dt><dd><%= stats.customers %></dd></div>
    </dl>
  </section>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="sheet" id="followups">
        <h2 class="sheet-title">Who to follow up with</h2>
        <p class="sheet-sub">Ranked by how much is pending and how long since the last payment.</p>
        <% if (!followUps.length) { %><div class="empty">No pending credit yet. Add an entry and the list builds itself.</div><% } %>
        <ul class="follow-list">
          <% followUps.slice(0, 6).forEach((item) => { %>
            <li class="follow-item">
              <span class="avatar" aria-hidden="true"><%= item.name.slice(0, 1).toUpperCase() %></span>
              <div>
                <h3 class="follow-name"><%= item.name %><span class="tag tag-<%= item.level %>"><%= label[item.level] %></span></h3>
                <p class="follow-meta"><%= item.daysSincePayment %> days since last payment</p>
                <p class="follow-why"><%= item.reasons.join(' · ') %></p>
              </div>
              <div class="follow-side">
                <span class="amt"><%= inr(item.balance) %></span>
                <div class="follow-actions">
                  <a class="btn btn-quiet" href="/customers/<%= item.customerId %>">Ledger</a>
                  <% if (item.phone && item.phone.replace(/\D/g, '').length >= 8) { %><a class="btn btn-primary" target="_blank" rel="noopener noreferrer" href="https://wa.me/<%= item.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent('Hi ' + item.name + ', your pending amount is ' + inr(item.balance) + '. Please settle it when convenient. Thank you.') %>">Remind</a><% } %>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="sheet">
        <h2 class="sheet-title">Add by typing</h2>
        <p class="sheet-sub">Write it like you’d say it. You’ll see a preview first.</p>
        <a href="/entry#natural" class="btn btn-primary w-100">Open the entry desk</a>
      </div>
      <div class="sheet mt-4">
        <div class="sheet-head"><h2 class="sheet-title">Recent entries</h2><a href="/entry">Add</a></div>
        <% if (!recent.length) { %><div class="empty">Nothing recorded yet.</div><% } %>
        <ul class="recent">
          <% recent.forEach(tx => { %>
            <li>
              <div><b><%= tx.customerId?.name || 'Customer' %></b><small><%= tx.description || (tx.type === 'credit' ? 'Credit' : 'Payment') %></small></div>
              <span class="amt amt-<%= tx.type %>"><%= signed(tx.type, tx.amount) %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
