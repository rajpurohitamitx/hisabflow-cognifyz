<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <div class="page-head"><div><h1 class="page-title">Daily closing</h1><p class="page-lead">Today’s totals before you pull the shutter down.</p></div></div>
  <section class="summary mb-4" aria-label="Today">
    <div><div class="summary-label">Still outstanding</div><div class="big-figure"><%= inr(outstanding) %></div><p class="summary-note">Across all customers, as of now.</p></div>
    <dl class="figures">
      <div><dt>Credit today</dt><dd><%= inr(today.credit?.total || 0) %></dd></div>
      <div><dt>Payments today</dt><dd><%= inr(today.payment?.total || 0) %></dd></div>
      <div><dt>Entries today</dt><dd><%= (today.credit?.count || 0) + (today.payment?.count || 0) %></dd></div>
    </dl>
  </section>
  <div class="sheet">
    <h2 class="sheet-title">Start tomorrow with these</h2>
    <p class="sheet-sub">Customers with pending credit, most important first.</p>
    <% if (!followUps.length) { %><div class="empty">Everything is settled. Nothing to chase tomorrow.</div><% } %>
    <ul class="follow-list">
      <% followUps.slice(0, 5).forEach(item => { %>
        <li class="follow-item">
          <span class="avatar" aria-hidden="true"><%= item.name.slice(0, 1).toUpperCase() %></span>
          <div><h3 class="follow-name"><%= item.name %></h3><p class="follow-why"><%= item.reasons.join(' · ') %></p></div>
          <div class="follow-side"><span class="amt"><%= inr(item.balance) %></span></div>
        </li>
      <% }) %>
    </ul>
  </div>
</main>
<%- include('../partials/footer') %>
