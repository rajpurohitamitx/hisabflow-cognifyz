<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main"><div class="mb-4"><div class="eyebrow">END OF DAY</div><h1 class="page-title">Daily closing</h1><p class="muted">A quick snapshot before you close the shop.</p></div>
<div class="row g-3"><div class="col-md-6 col-xl-3"><div class="stat-card"><span>Credit today</span><strong>₹<%= (today.credit?.total || 0).toLocaleString('en-IN') %></strong><small><%= today.credit?.count || 0 %> entries</small></div></div><div class="col-md-6 col-xl-3"><div class="stat-card"><span>Payments today</span><strong>₹<%= (today.payment?.total || 0).toLocaleString('en-IN') %></strong><small><%= today.payment?.count || 0 %> entries</small></div></div><div class="col-md-6 col-xl-3"><div class="stat-card"><span>Outstanding</span><strong>₹<%= outstanding.toLocaleString('en-IN') %></strong><small>Current total</small></div></div><div class="col-md-6 col-xl-3"><div class="stat-card"><span>Follow-ups</span><strong><%= followUps.filter(x=>x.level!=='healthy').length %></strong><small>Need attention</small></div></div></div>
<div class="panel-card mt-4"><div class="panel-head"><div><h2>Tomorrow's starting point</h2><p>These customers have pending credit and may need a follow-up.</p></div></div><div class="follow-list"><% followUps.slice(0,5).forEach(item=>{ %><div class="follow-row <%= item.level %>"><div class="avatar"><%= item.name.slice(0,1).toUpperCase() %></div><div class="follow-main"><h3><%= item.name %></h3><p><%= item.reasons.join(' · ') %></p></div><div class="follow-right"><strong>₹<%= item.balance.toLocaleString('en-IN') %></strong></div></div><% }) %></div></div></main><%- include('../partials/footer') %>
