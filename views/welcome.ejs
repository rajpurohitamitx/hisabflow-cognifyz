<%- include('partials/head') %>
<noscript><meta http-equiv="refresh" content="3;url=/dashboard"></noscript>
<div class="auth-shell"><div class="auth-card text-center welcome-card">
  <img src="/img/logo.svg" alt="" class="brand-logo mx-auto d-block" width="48" height="48" style="width:48px;height:48px;border-radius:14px">
  <h1 class="section-title mt-4"><%= isNew ? 'Welcome to HisaabFlow, ' : 'Welcome back, ' %><%= firstName %>!</h1>
  <p class="muted mb-1"><%= isNew ? 'Your shop ' + shop.name + ' is ready. Add your first customer and start tracking credit.' : 'Taking you to ' + shop.name + '.' %></p>
  <div class="welcome-bar"><span></span></div>
  <a class="btn btn-primary btn-lg rounded-pill px-4 mt-3" href="/dashboard" id="goShop">Go to my shop</a>
</div></div>
<script>setTimeout(function(){ location.replace('/dashboard'); }, 2500);</script>
<%- include('partials/footer') %>
