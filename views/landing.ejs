<%- include('partials/head') %>
<div class="landing-shell">
  <div class="container py-4 py-lg-5">
    <nav class="d-flex align-items-center justify-content-between mb-5">
      <div class="d-flex align-items-center gap-2"><img src="/img/logo.svg" alt="" class="brand-logo" width="34" height="34"><strong>HisabFlow</strong></div>
      <a class="btn btn-outline-light rounded-pill px-4" href="/auth/login">Sign in</a>
    </nav>
    <div class="row align-items-center g-5 py-lg-5">
      <div class="col-lg-7">
        <div class="eyebrow">Small-shop credit, without the notebook chaos</div>
        <h1 class="display-title">Know <span>who needs a follow-up</span> before the day gets busy.</h1>
        <p class="lead landing-copy">HisabFlow turns customer credit entries into a simple daily action list, so shopkeepers spend less time scanning pages and more time running the shop.</p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a href="/auth/register" class="btn btn-primary btn-lg rounded-pill px-4">Create a shop account</a>
          <a href="/auth/login" class="btn btn-outline-light btn-lg rounded-pill px-4">Sign in</a>
        </div>
        <div class="trust-row mt-4"><span>✓ Explainable follow-ups</span><span>✓ Mobile-first</span><span>✓ Shop data isolation</span></div>
      </div>
      <div class="col-lg-5">
                <svg class="money-art" viewBox="0 0 360 150" role="img" aria-label="Rupee notes and coins" style="width:100%;max-width:420px;display:block;margin:0 auto 20px">
          <g transform="rotate(-6 120 80)"><rect x="20" y="30" width="200" height="100" rx="10" fill="#cfe8d5" stroke="#2f7d4f" stroke-width="3"/><rect x="32" y="42" width="176" height="76" rx="6" fill="none" stroke="#2f7d4f" stroke-dasharray="4 4"/><circle cx="120" cy="80" r="26" fill="#2f7d4f"/><text x="120" y="91" text-anchor="middle" font-size="30" font-weight="700" fill="#fff" font-family="Georgia,serif">₹</text><text x="44" y="62" font-size="16" font-weight="700" fill="#1f5c38" font-family="Georgia,serif">500</text><text x="196" y="112" text-anchor="end" font-size="16" font-weight="700" fill="#1f5c38" font-family="Georgia,serif">500</text></g>
          <g transform="rotate(5 200 70)"><rect x="110" y="14" width="190" height="96" rx="10" fill="#f6e3b4" stroke="#b9871c" stroke-width="3"/><circle cx="205" cy="62" r="24" fill="#b9871c"/><text x="205" y="73" text-anchor="middle" font-size="28" font-weight="700" fill="#fff" font-family="Georgia,serif">₹</text><text x="128" y="40" font-size="15" font-weight="700" fill="#7a5710" font-family="Georgia,serif">100</text><text x="284" y="98" text-anchor="end" font-size="15" font-weight="700" fill="#7a5710" font-family="Georgia,serif">100</text></g>
          <g><circle cx="300" cy="112" r="26" fill="#e8c35a" stroke="#a87c12" stroke-width="3"/><circle cx="300" cy="112" r="19" fill="none" stroke="#a87c12"/><text x="300" y="121" text-anchor="middle" font-size="24" font-weight="700" fill="#7a5710" font-family="Georgia,serif">₹10</text></g>
          <g><circle cx="338" cy="96" r="18" fill="#d9dde2" stroke="#8a929b" stroke-width="3"/><text x="338" y="102" text-anchor="middle" font-size="16" font-weight="700" fill="#4b535c" font-family="Georgia,serif">₹5</text></g>
        </svg>
        <div class="hero-phone shadow-lg">
          <div class="phone-top"><span>Today</span><span class="mini-dot"></span></div>
          <div class="phone-balance">₹18,420 <small>outstanding</small></div>
          <div class="mini-card urgent"><div><b>Ramesh</b><small>32 days since payment</small></div><strong>₹1,240</strong></div>
          <div class="mini-card watch"><div><b>Suresh</b><small>18 days since payment</small></div><strong>₹680</strong></div>
          <div class="mini-card healthy"><div><b>Kumar</b><small>3 days since payment</small></div><strong>₹240</strong></div>
          <div class="mini-action">Why is Ramesh first? <span>→</span></div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
