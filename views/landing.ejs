<%- include('partials/head') %>
<div class="landing-shell">
  <div class="container py-4 py-lg-5">
    <nav class="d-flex align-items-center justify-content-between mb-5">
      <div class="d-flex align-items-center gap-2"><img src="/img/logo.svg" alt="" class="brand-logo" width="34" height="34"><strong>HisaabFlow</strong></div>
      <a class="btn btn-outline-light rounded-pill px-4" href="/auth/login">Sign in</a>
    </nav>
    <div class="row align-items-center g-5 py-lg-4">
      <div class="col-lg-7">
        <p class="eyebrow">Small-shop credit, without the notebook chaos</p>
        <h1 class="display-title">Know <span>who needs a follow-up</span> before the day gets busy.</h1>
        <p class="lead landing-copy">HisaabFlow turns customer credit entries into a simple daily action list, so shopkeepers spend less time scanning pages and more time running the shop.</p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <a href="/auth/register" class="btn btn-primary btn-lg rounded-pill px-4">Create a shop account</a>
          <a href="/auth/login" class="btn btn-outline-light btn-lg rounded-pill px-4">Sign in</a>
        </div>
      </div>
      <div class="col-lg-5 d-none d-md-block">
        <svg class="hero-cash" viewBox="0 0 520 330" role="img" aria-label="Rupee notes and coins" xmlns="http://www.w3.org/2000/svg">
          <g transform="rotate(-6 170 175)">
            <rect x="20" y="95" width="300" height="170" rx="14" fill="#cfe8d6" stroke="#2f8a5b" stroke-width="5"/>
            <rect x="36" y="111" width="268" height="138" rx="8" fill="none" stroke="#2f8a5b" stroke-width="2" stroke-dasharray="6 5"/>
            <text x="56" y="160" font-family="Georgia,'Times New Roman',serif" font-weight="700" font-size="24" fill="#1f6b45">500</text>
            <circle cx="245" cy="180" r="38" fill="#2f8a5b"/>
          </g>
          <g transform="rotate(5 300 125)">
            <rect x="160" y="35" width="300" height="170" rx="14" fill="#f8e3b2" stroke="#c28a1f" stroke-width="5"/>
            <text x="186" y="80" font-family="Georgia,'Times New Roman',serif" font-weight="700" font-size="22" fill="#8a5a0c">100</text>
            <text x="388" y="188" font-family="Georgia,'Times New Roman',serif" font-weight="700" font-size="22" fill="#8a5a0c">100</text>
            <circle cx="310" cy="120" r="38" fill="#c28a1f"/>
            <text x="310" y="136" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-weight="700" font-size="44" fill="#fff6dc">&#8377;</text>
          </g>
          <circle cx="468" cy="215" r="30" fill="#dfe3ea" stroke="#aab0bb" stroke-width="5"/>
          <text x="468" y="224" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-weight="700" font-size="22" fill="#555c68">&#8377;5</text>
          <circle cx="418" cy="250" r="42" fill="#ebc24f" stroke="#b8861b" stroke-width="5"/>
          <circle cx="418" cy="250" r="32" fill="none" stroke="#c9981f" stroke-width="2"/>
          <text x="418" y="261" text-anchor="middle" font-family="Inter,Arial,sans-serif" font-weight="800" font-size="30" fill="#7a5208">&#8377;10</text>
        </svg>
      </div>
    </div>
    <ol class="landing-steps">
      <li><b>Type it</b><span>“Suresh ne 500 diye”, “Anita bought 2 kg sugar at 45”, “Jinal ne jawar 500rs ka liya”</span></li>
      <li><b>Check it</b><span>You see the customer, items and amounts before anything is saved.</span></li>
      <li><b>Follow up</b><span>The oldest and biggest dues come first, with the reason shown.</span></li>
    </ol>
  </div>
</div>
