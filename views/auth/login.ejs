<%- include('../partials/head') %>
<div class="auth-shell"><div class="auth-card">
  <a class="brand-lockup" href="/"><img src="/img/logo.svg" alt="" class="brand-logo" width="32" height="32"><span class="brand-name">HisabFlow</span></a>
  <h1>Welcome back</h1>
  <p class="muted">Sign in to see who needs a follow-up today.</p>
  <% if (error) { %><div class="msg msg-danger mt-3" role="alert"><%= error %></div><% } %>
  <form method="post" action="/auth/login" class="mt-3" id="loginForm">
    <label class="form-label" for="loginEmail">Email</label>
    <input id="loginEmail" class="form-control" type="email" name="email" required autocomplete="email" maxlength="254">
    <label class="form-label mt-3" for="loginPassword">Password</label>
    <input id="loginPassword" class="form-control" type="password" name="password" required autocomplete="current-password" maxlength="200">
    <button class="btn btn-primary btn-lg w-100 mt-4">Sign in</button>
  </form>
  <p class="text-center muted mt-4 mb-0">New here? <a href="/auth/register">Create your shop</a></p>
</div></div>
<%- include('../partials/footer') %>
