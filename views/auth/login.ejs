<%- include('../partials/head') %>
<div class="auth-shell"><div class="auth-card">
  <a class="brand-lockup" href="/"><img src="/img/logo.svg" alt="" class="brand-logo" width="34" height="34"><span>HisabFlow</span></a>
  <div class="mt-5"><div class="eyebrow">Welcome back</div><h1 class="section-title">Open your shop desk.</h1><p class="muted">See today's follow-ups, outstanding credit and recent activity.</p></div>
  <% if (error) { %><div class="alert alert-danger mt-4" role="alert"><%= error %></div><% } %>
  <form method="post" action="/auth/login" class="mt-4" id="loginForm" novalidate>
    <label class="form-label" for="loginEmail">Email</label><input id="loginEmail" class="form-control form-control-lg" type="email" name="email" required autocomplete="email">
    <label class="form-label mt-3" for="loginPassword">Password</label><input id="loginPassword" class="form-control form-control-lg" type="password" name="password" required autocomplete="current-password">
    <button class="btn btn-primary btn-lg w-100 rounded-pill mt-4">Sign in</button>
  </form>
  <p class="text-center muted mt-4 mb-0">New shop? <a href="/auth/register">Create an account</a></p>
</div></div>
<%- include('../partials/footer') %>
