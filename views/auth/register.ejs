<%- include('../partials/head') %>
<div class="auth-shell"><div class="auth-card">
  <a class="brand-lockup" href="/"><span class="brand-mark">H</span><span>HisabFlow</span></a>
  <div class="mt-5"><div class="eyebrow">SET UP YOUR SHOP</div><h1 class="section-title">Start with a cleaner khata.</h1><p class="muted">Your account keeps each shop's customers and transactions isolated.</p></div>
  <% if (error) { %><div class="alert alert-danger mt-4"><%= error %></div><% } %>
  <form method="post" action="/auth/register" class="mt-4" id="registerForm">
    <div id="registerAlert"></div>
    <label class="form-label">Shop name</label><input class="form-control" name="shopName" required maxlength="100" placeholder="Sri Lakshmi Stores">
    <label class="form-label mt-3">Owner name</label><input class="form-control" name="ownerName" required maxlength="80" placeholder="Your name">
    <label class="form-label mt-3">Email</label><input class="form-control" type="email" name="email" required placeholder="you@example.com">
    <label class="form-label mt-3">Password</label><input class="form-control" id="password" type="password" name="password" required minlength="8" placeholder="At least 8 characters">
    <div class="strength mt-2"><span id="strengthBar"></span></div><small id="strengthText" class="muted">Use 8+ characters with a mix of letters and numbers.</small>
    <button class="btn btn-primary btn-lg w-100 rounded-pill mt-4">Create shop</button>
  </form>
  <p class="text-center muted mt-4">Already have an account? <a href="/auth/login">Sign in</a></p>
</div></div>
<%- include('../partials/footer') %>
