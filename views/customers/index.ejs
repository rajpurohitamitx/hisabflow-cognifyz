<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="eyebrow">LEDGER</div><h1 class="page-title">Customers</h1><p class="muted mb-0">Every account stays inside your shop.</p></div><a href="/entry" class="btn btn-primary rounded-pill px-4">+ Add transaction</a></div>
  <div class="panel-card"><div class="search-row"><input id="customerSearch" class="form-control" placeholder="Search customers…"><span class="muted"><%= customers.length %> active</span></div>
  <div class="table-responsive"><table class="table app-table align-middle"><thead><tr><th>Customer</th><th>Phone</th><th>Balance</th><th>State</th><th></th></tr></thead><tbody id="customerRows">
  <% customers.forEach(c => { %><tr><td><div class="customer-cell"><span class="avatar"><%= c.name.slice(0,1).toUpperCase() %></span><div><b><%= c.name %></b><small><%= c.notes || 'No notes' %></small></div></div></td><td><%= c.phone || '—' %></td><td><strong>₹<%= c.balance.toLocaleString('en-IN') %></strong></td><td><span class="status-pill <%= c.balance > 0 ? 'status-warning' : 'status-good' %>"><%= c.balance > 0 ? 'Pending' : 'Settled' %></span></td><td class="text-end"><a href="/customers/<%= c._id %>" class="btn btn-sm btn-soft">Open ledger</a></td></tr><% }) %>
  </tbody></table></div></div>
</main><%- include('../partials/footer') %>
