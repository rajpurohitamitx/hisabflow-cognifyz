<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <a href="/customers" class="text-link">← Customers</a>
  <div class="detail-head mt-3"><div><div class="eyebrow">Customer ledger</div><div class="d-flex align-items-center gap-3"><span class="avatar avatar-lg"><%= customer.name.slice(0,1).toUpperCase() %></span><div><h1 class="page-title mb-1"><%= customer.name %></h1><p class="muted mb-0"><%= customer.phone || 'No phone added' %></p></div></div></div><div class="balance-box"><span>Current outstanding</span><strong>₹<%= balance.toLocaleString('en-IN') %></strong><% if (customer.phone) { %><a target="_blank" rel="noopener" href="https://wa.me/<%= customer.phone.replace(/\D/g,'') %>?text=<%= encodeURIComponent(`Hi ${customer.name}, your pending amount is ₹${balance.toLocaleString('en-IN')}. Please settle it when convenient. Thank you.`) %>" class="btn btn-primary btn-sm rounded-pill">Send reminder</a><% } else { %><span class="muted small">Add a phone number to send a reminder.</span><% } %></div></div>
  <div class="panel-card mt-4"><div class="panel-head"><div><h2>Transaction history</h2><p>Credits increase the balance; payments reduce it.</p></div><a href="/entry" class="btn btn-soft btn-sm">+ Entry</a></div>
  <div class="timeline"><% transactions.forEach(tx => { %><div class="timeline-row"><div class="timeline-dot <%= tx.type %>"></div><div class="flex-grow-1"><b><%= tx.type === 'credit' ? 'Credit given' : 'Payment received' %></b><small><%= new Date(tx.occurredAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %> · <%= tx.description || 'No description' %></small></div><strong class="<%= tx.type === 'credit' ? 'text-credit' : 'text-payment' %>"><%= tx.type === 'credit' ? '+' : '-' %>₹<%= tx.amount.toLocaleString('en-IN') %></strong></div><% }) %></div></div>
</main><%- include('../partials/footer') %>
