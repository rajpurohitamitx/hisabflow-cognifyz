<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <a href="/customers">← All customers</a>
  <div class="ledger-head">
    <div class="d-flex align-items-center gap-3">
      <span class="avatar" aria-hidden="true"><%= customer.name.slice(0, 1).toUpperCase() %></span>
      <div><h1 class="page-title"><%= customer.name %></h1><p class="page-lead"><%= customer.phone || 'No phone number saved' %></p></div>
    </div>
    <div class="balance-box">
      <span>Outstanding now</span><strong><%= inr(balance) %></strong>
      <% if (customer.phone && customer.phone.replace(/\D/g, '').length >= 8 && balance > 0) { %>
        <a class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer" href="https://wa.me/<%= customer.phone.replace(/\D/g, '') %>?text=<%= encodeURIComponent('Hi ' + customer.name + ', your pending amount is ' + inr(balance) + '. Please settle it when convenient. Thank you.') %>">Send reminder</a>
      <% } else if (!customer.phone) { %><span class="muted small">Add a phone number to send a reminder.</span><% } %>
    </div>
  </div>

  <div class="sheet">
    <div class="sheet-head"><div><h2 class="sheet-title">Ledger</h2><p class="sheet-sub">+ is credit given, − is payment received.</p></div><a class="btn btn-quiet btn-sm" href="/entry">Add entry</a></div>
    <% if (!transactions.length) { %><div class="empty">No entries for <%= customer.name %> yet.</div><% } else { %>
    <div class="table-wrap"><table class="ledger-table">
      <thead><tr><th>Date</th><th>Details</th><th class="num">Amount</th><th class="num col-hide-sm">Balance</th><th></th></tr></thead>
      <tbody>
        <% transactions.forEach(tx => { %>
          <tr>
            <td><%= fmtDateTime(tx.occurredAt) %></td>
            <td><b><%= tx.type === 'credit' ? 'Credit given' : 'Payment received' %></b>
              <% if (tx.items && tx.items.length) { %><% tx.items.forEach(i => { %><span class="items-line"><%= i.qty && i.qty !== 1 ? i.qty + (i.unit ? ' ' + i.unit : '') + ' × ' : '' %><%= i.name %><%= i.price ? ' @ ' + inr(i.price) : '' %></span><% }) %>
              <% } else if (tx.description && tx.description !== 'Payment received') { %><span class="items-line"><%= tx.description %></span><% } %></td>
            <td class="num"><span class="amt amt-<%= tx.type %>"><%= signed(tx.type, tx.amount) %></span></td>
            <td class="num col-hide-sm"><%= inr(tx.running) %></td>
            <td class="num row-actions">
              <button type="button" class="btn btn-quiet tx-edit" data-id="<%= tx._id %>" data-type="<%= tx.type %>" data-amount="<%= tx.amount %>" data-note="<%= tx.description || '' %>">Edit</button>
              <button type="button" class="btn-link-danger tx-delete" data-id="<%= tx._id %>" data-amount="<%= tx.amount %>">Delete</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
    <% } %>
  </div>
</main>

<div class="modal fade" id="txModal" tabindex="-1" aria-labelledby="txModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
  <div class="modal-header border-0 pb-0"><h2 class="modal-title fs-5" id="txModalTitle">Edit entry</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
    <div id="txError" aria-live="polite"></div>
    <label class="form-label" for="txType">Type</label>
    <select id="txType" class="form-select"><option value="credit">Credit given</option><option value="payment">Payment received</option></select>
    <label class="form-label mt-3" for="txAmount">Amount (₹)</label>
    <input id="txAmount" class="form-control" type="number" min="0.01" step="0.01" inputmode="decimal">
    <label class="form-label mt-3" for="txNote">Note</label>
    <input id="txNote" class="form-control" type="text" maxlength="200">
  </div>
  <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-quiet" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="txSave">Save changes</button></div>
</div></div></div>
<%- include('../partials/footer') %>
