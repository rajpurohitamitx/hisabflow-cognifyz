<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container-fluid px-3 px-lg-4 py-4 app-main">
  <a href="/customers" class="text-link">← Customers</a>
  <div class="detail-head mt-3"><div><div class="d-flex align-items-center gap-3"><span class="avatar avatar-lg"><%= customer.name.slice(0,1).toUpperCase() %></span><div><h1 class="page-title mb-1"><%= customer.name %></h1><div class="muted mb-0 phone-line" id="phoneLine" data-customer="<%= customer._id %>"><% if (customer.phone) { %><span class="phone-num"><svg class="ic" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.34 1.77.66 2.6a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.83.32 1.7.54 2.6.66A2 2 0 0 1 22 16.92z"/></svg> <%= customer.phone %></span> <button type="button" class="link-btn" id="phoneEdit">Edit</button><% } else { %><button type="button" class="link-btn" id="phoneEdit">+ Add phone number</button><% } %></div>
<form id="phoneForm" class="phone-form d-none" novalidate><input id="phoneInput" class="form-control form-control-sm" type="tel" inputmode="tel" maxlength="20" placeholder="e.g. 98765 43210" value="<%= customer.phone || '' %>" aria-label="Phone number"><button class="btn btn-primary btn-sm rounded-pill px-3">Save</button><button type="button" class="btn btn-ghost btn-sm rounded-pill" id="phoneCancel">Cancel</button></form><div id="phoneMsg" class="small mt-1" aria-live="polite"></div></div></div></div><div class="balance-box"><% if (balance < 0) { %><span>Advance held for <%= customer.name %></span><strong class="text-payment">−₹<%= Math.abs(balance).toLocaleString('en-IN') %></strong><span class="muted small">Adjusted automatically in the next purchase.</span><% } else { %><span>Current outstanding</span><strong class="<%= balance > 0 ? 'text-due' : '' %>">₹<%= balance.toLocaleString('en-IN') %></strong><% if (balance > 0 && customer.phone) { %><a target="_blank" rel="noopener" href="https://wa.me/<%= (d => d.length === 10 ? '91' + d : d)(customer.phone.replace(/\D/g,'')) %>?text=<%= encodeURIComponent(`Hi ${customer.name}, your pending amount is ₹${balance.toLocaleString('en-IN')}. Please settle it when convenient. Thank you.`) %>" class="btn btn-primary btn-sm rounded-pill">Send reminder</a><% } else if (balance > 0) { %><span class="muted small">Add a phone number to send a reminder.</span><% } %><% } %></div></div>
  <div class="panel-card mt-4"><div class="panel-head"><div><h2>Transaction history</h2></div><a href="/entry" class="btn btn-soft btn-sm">+ Entry</a></div>
  <div class="timeline"><% transactions.forEach(tx => { %><div class="timeline-row"><div class="timeline-dot <%= tx.type %>"></div><div class="flex-grow-1"><b><%= tx.type === 'credit' ? 'Credit given' : 'Payment received' %></b><small><%= fmtDateTime(tx.occurredAt) %> · <%= tx.description || 'No description' %></small></div><strong class="amt <%= tx.type === 'credit' ? 'text-credit' : 'text-payment' %>"><span class="amt-sign"><%= tx.type === 'credit' ? '−' : '+' %></span>₹<%= tx.amount.toLocaleString('en-IN') %></strong><div class="tx-actions"><button type="button" class="btn btn-sm btn-soft tx-edit" data-id="<%= tx._id %>" data-type="<%= tx.type %>" data-amount="<%= tx.amount %>" data-note="<%= tx.description || '' %>">Edit</button><button type="button" class="btn btn-sm btn-ghost tx-delete" data-id="<%= tx._id %>" data-amount="<%= tx.amount %>">Delete</button></div></div><% }) %></div></div>
</main>
<div class="modal fade" id="txModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" style="border-radius:20px">
  <div class="modal-header border-0 pb-0"><h2 class="modal-title fs-5">Edit entry</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
    <div id="txError"></div>
    <label class="form-label" for="txType">Type</label>
    <select id="txType" class="form-select"><option value="credit">Credit given</option><option value="payment">Payment received</option></select>
    <label class="form-label mt-3" for="txAmount">Amount (₹)</label>
    <input id="txAmount" class="form-control" type="number" min="1" step="0.01" inputmode="decimal">
    <label class="form-label mt-3" for="txNote">Note</label>
    <input id="txNote" class="form-control" type="text" maxlength="160">
  </div>
  <div class="modal-footer border-0 pt-0"><button type="button" class="btn btn-ghost rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary rounded-pill px-4" id="txSave">Save changes</button></div>
</div></div></div>
<%- include('../partials/footer') %>
